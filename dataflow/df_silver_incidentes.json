{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "incidentes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "fechas"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> incidentes",
				"incidentes derive(FechaHoraInicio = coalesce(toTimestamp(FechaHoraInicio, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraInicio, 'dd/MM/yyyy HH:mm')),",
				"          FechaHoraFin = coalesce(toTimestamp(FechaHoraFin, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraFin, 'dd/MM/yyyy HH:mm')),",
				"          FechaHoraRegistro = coalesce(toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraRegistro, 'dd/MM/yyyy HH:mm'))) ~> fechas",
				"fechas derive(IncidenteId = iif(isNull(IncidenteId) || length(trim(toString(IncidenteId))) == 0, concat('IN-GEN-', toString(year(FechaHoraInicio)), toString(month(FechaHoraInicio)), toString(dayOfMonth(FechaHoraInicio))), trim(toString(IncidenteId))),",
				"          TipoIncidente = trim(TipoIncidente),",
				"          Severidad = trim(Severidad),",
				"          VehiculoId = iif(isNull(VehiculoId) || length(trim(toString(VehiculoId))) == 0, 'SIN DATO', trim(toString(VehiculoId))),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraRegistro = iif(isNull(FechaHoraRegistro), toTimestamp('00:00:00', 'HH:mm:ss'), FechaHoraRegistro)\r",
				",",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == 'NULL' || length(trim(VehiculoId)) == 0, toString(null()), trim(VehiculoId)),",
				"          FechaHoraFin = iif(isNull(FechaHoraFin), toTimestamp('00:00:00', 'HH:mm:ss'),FechaHoraFin ),",
				"          FechaHoraInicio = iif(isNull(FechaHoraInicio), toTimestamp('00:00:00', 'HH:mm:ss'), FechaHoraInicio)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId = FechaHoraRegistro,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}