{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "vehiculos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vehiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "VIGENCIAS"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> vehiculos",
				"vehiculos derive(VigenciaDesde = iif(isInteger(VigenciaDesde), addDays(toDate('1899-12-30'), toInteger(VigenciaDesde)), coalesce(toDate(VigenciaDesde, 'dd/MM/yyyy'), toDate(VigenciaDesde, 'yyyy-MM-dd'))),",
				"          VigenciaHasta = iif(isInteger(VigenciaHasta), addDays(toDate('1899-12-30'), toInteger(VigenciaHasta)), coalesce(toDate(VigenciaHasta, 'dd/MM/yyyy'), toDate(VigenciaHasta, 'yyyy-MM-dd')))) ~> VIGENCIAS",
				"VIGENCIAS derive(VehiculoId = iif(startsWith(VehiculoId, 'V-'), VehiculoId, concat('V-', lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0'))),",
				"          Placa = trim(Placa),",
				"          TipoVehiculo = trim(TipoVehiculo),",
				"          CapacidadEfectiva = toInteger(CapacidadEfectiva),",
				"          Estado = trim(Estado)) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(Placa,",
				"          VehiculoId),",
				"     TipoVehiculo = first(TipoVehiculo),",
				"          CapacidadEfectiva = first(CapacidadEfectiva),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}