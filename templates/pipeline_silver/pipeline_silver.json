						"source(output(",
						"          AnioFuente as integer,",
						"          IncidenteId as string,",
						"          RutaHistoricaId as string,",
						"          EsPrincipal as boolean",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(RutaHistoricaId = trim(RutaHistoricaId)) ~> derivedColumn1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          IncidenteId as string,",
						"          RutaHistoricaId as string,",
						"          EsPrincipal as boolean",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          IncidenteId,",
						"          RutaHistoricaId,",
						"          EsPrincipal",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/bronze_incidente_ruta_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_incidente_ruta_sql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_demanda_paradas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_demanda_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_demanda_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AnioFuente as string,",
						"          DemandaId as string,",
						"          FechaServicio as string,",
						"          RutaHistoricaId as string,",
						"          ParadaHistoricaId as string,",
						"          Franja as string,",
						"          ValidacionesTarjeta as string,",
						"          Descensos as string,",
						"          DemandaNoAtendida as string,",
						"          Metodo as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(FechaServicio = coalesce(toDate(FechaServicio, 'dd/MM/yyyy'), toDate(FechaServicio, 'yyyy-MM-dd'))) ~> derivedColumn1",
						"derivedColumn1 derive(RutaHistoricaId = iif(startsWith(RutaHistoricaId, 'RH-'), RutaHistoricaId, concat('RH-', lpad(regexReplace(RutaHistoricaId, '[^0-9]', ''), 2, '0'))),",
						"          DemandaId = iif(isNull(DemandaId), concat('DM-', '-', toString(FechaServicio, 'yyyyMMdd'), '-', RutaHistoricaId, '-', ParadaHistoricaId, '-', regexReplace(Franja, '[^0-9]', '')), DemandaId),",
						"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
						"          Descensos = toInteger(Descensos),",
						"          DemandaNoAtendida = toInteger(DemandaNoAtendida)) ~> derivedColumn3",
						"derivedColumn3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          DemandaId as string,",
						"          FechaServicio as date,",
						"          RutaHistoricaId as string,",
						"          ParadaHistoricaId as string,",
						"          Franja as string,",
						"          ValidacionesTarjeta as integer,",
						"          Descensos as integer,",
						"          DemandaNoAtendida as integer,",
						"          Metodo as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          DemandaId,",
						"          FechaServicio,",
						"          RutaHistoricaId,",
						"          ParadaHistoricaId,",
						"          Franja,",
						"          ValidacionesTarjeta,",
						"          Descensos,",
						"          DemandaNoAtendida,",
						"          Metodo",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_demanda_paradas_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_demanda_paradas_sql')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_incidentes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_incidentes_sql",
								"type": "DatasetReference"
							},
							"name": "incidentes"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_incidentes_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "fechas"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AnioFuente as string,",
						"          IncidenteId as string,",
						"          TipoIncidente as string,",
						"          Severidad as string,",
						"          FechaHoraInicio as string,",
						"          FechaHoraFin as string,",
						"          FechaHoraRegistro as string,",
						"          VehiculoId as string,",
						"          Descripcion as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> incidentes",
						"incidentes derive(FechaHoraInicio = coalesce(toTimestamp(FechaHoraInicio, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraInicio, 'dd/MM/yyyy HH:mm')),",
						"          FechaHoraFin = coalesce(toTimestamp(FechaHoraFin, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraFin, 'dd/MM/yyyy HH:mm')),",
						"          FechaHoraRegistro = coalesce(toTimestamp(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss'), toTimestamp(FechaHoraRegistro, 'dd/MM/yyyy HH:mm'))) ~> fechas",
						"fechas derive(IncidenteId = trim(IncidenteId),",
						"          TipoIncidente = trim(TipoIncidente),",
						"          Severidad = trim(Severidad),",
						"          VehiculoId = iif(isNull(VehiculoId), toString(null()), trim(VehiculoId)),",
						"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
						"derivedColumn1 derive(IncidenteId = iif(isNull(FechaHoraRegistro), toString(FechaHoraInicio), toString(FechaHoraRegistro))) ~> derivedColumn2",
						"derivedColumn2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          IncidenteId as string,",
						"          TipoIncidente as string,",
						"          Severidad as string,",
						"          FechaHoraInicio as timestamp,",
						"          FechaHoraFin as timestamp,",
						"          FechaHoraRegistro as timestamp,",
						"          VehiculoId as string,",
						"          Descripcion as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          TipoIncidente,",
						"          Severidad,",
						"          FechaHoraInicio,",
						"          FechaHoraFin,",
						"          FechaHoraRegistro,",
						"          VehiculoId,",
						"          Descripcion",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/dw_bronze_incidentes_sql')]",
				"[concat(variables('factoryId'), '/datasets/dw_silver_incidentes_sql')]"
			]
